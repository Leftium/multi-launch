{
	"name": "multi-launch",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write .",
		"knip": "knip"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@leftium/nimble.css": "^0.24.1",
		"@ltd/j-toml": "^1.38.0",
		"@sveltejs/adapter-auto": "^8.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/debug": "^4.1.13",
		"@types/lodash": "^4.17.27",
		"@types/node": "^25.9.9",
		"debug": "^4.4.3",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"iconify-icon": "^3.0.5",
		"knip": "^6.47.0",
		"lodash": "^4.18.1",
		"lz-string": "^1.5.0",
		"mdsvex": "^0.12.8",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^3.5.2",
		"sass": "^1.108.2",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"tippy.js": "^6.3.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vite-plugin-devtools-json": "^1.1.2",
		"web-sentinel": "^0.1.5"
	},
	"packageManager": "pnpm@10.12.2",
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	}
}
